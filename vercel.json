{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__vercel_subpath__=$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/cameras/new",
      "destination": "/add-camera.html"
    },
    {
      "source": "/areas/(.*)",
      "destination": "/areas.html"
    },
    {
      "source": "/clips/(.*)",
      "destination": "/clips.html"
    },
    {
      "source": "/login/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/setup/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/setup",
      "destination": "/index.html"
    }
  ]
}