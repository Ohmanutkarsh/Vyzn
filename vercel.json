{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/billing/(.*)",
      "destination": "/api"
    },
    {
      "source": "/billing",
      "destination": "/api"
    },
    {
      "source": "/admin/billing/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin/billing",
      "destination": "/api"
    },

    {
      "source": "/cameras/new",
      "destination": "/add-camera"
    },
    {
      "source": "/areas/(.*)",
      "destination": "/areas"
    },
    {
      "source": "/clips/(.*)",
      "destination": "/clips"
    },
    {
      "source": "/login/(.*)",
      "destination": "/login"
    },
    {
      "source": "/login",
      "destination": "/login"
    },
    {
      "source": "/setup/(.*)",
      "destination": "/setup"
    },
    {
      "source": "/setup",
      "destination": "/setup"
    }
  ]
}