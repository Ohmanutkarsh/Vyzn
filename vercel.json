{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/overview",
      "destination": "/overview.html"
    },
    {
      "source": "/cameras/new",
      "destination": "/add-camera.html"
    },
    {
      "source": "/cameras",
      "destination": "/cameras.html"
    },
    {
      "source": "/areas/(.*)",
      "destination": "/areas.html"
    },
    {
      "source": "/areas",
      "destination": "/areas.html"
    },
    {
      "source": "/clips/(.*)",
      "destination": "/clips.html"
    },
    {
      "source": "/clips",
      "destination": "/clips.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/design",
      "destination": "/design.html"
    },
    {
      "source": "/login/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/setup/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}