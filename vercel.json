{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/dashboard/**",
      "use": "@vercel/static"
    },
    {
      "src": "vyzn_cloud/templates/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/frontend/dashboard/$1"
    },
    {
      "src": "/fleet",
      "dest": "/api/index.py"
    },
    {
      "src": "/fleet/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/v/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dashboard/index.html"
    }
  ]
}