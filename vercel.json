{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/cameras/new(.*)",
      "destination": "/add-camera"
    },
    {
      "source": "/areas/(.*)",
      "destination": "/areas"
    },
    {
      "source": "/clips/(.*)",
      "destination": "/clips"
    },
    {
      "source": "/login/(.*)",
      "destination": "/"
    },
    {
      "source": "/login",
      "destination": "/"
    },
    {
      "source": "/setup/(.*)",
      "destination": "/"
    },
    {
      "source": "/setup",
      "destination": "/"
    }
  ]
}