# ========================================================================
# VYZN Netra — Environment Configuration
# ========================================================================

# ------------------------------------------------------------------------
# 1. OUTBOUND EMAIL (For Real Gmail / Email 6-Digit OTP Delivery)
# ------------------------------------------------------------------------
# To send real OTPs directly to your Gmail/Email, provide your Gmail address
# and a 16-character Google App Password (generate at https://myaccount.google.com/apppasswords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Alternative: Resend API (if using https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------
# 2. OUTBOUND MOBILE SMS (For Real Indian +91 SMS OTP Delivery)
# ------------------------------------------------------------------------
# Fast2SMS (Instant OTP gateway for Indian +91 numbers):
# Sign up at https://www.fast2sms.com and get your API Key from Dev API.
FAST2SMS_API_KEY=

# Alternative: Twilio SMS (International & India)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------
# 3. SUPABASE CLOUD DATABASE (User Storage & Login Audit Logs)
# ------------------------------------------------------------------------
# Create a free project at https://supabase.com
# Execute the SQL script in `supabase_setup.sql` in Supabase SQL Editor.
# Copy Project URL and Anon API Key from Project Settings -> API.
VYZN_SUPABASE_URL=
VYZN_SUPABASE_ANON_KEY=
VYZN_SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------
# 4. TELEGRAM ALERTS (Required for @Vyzn_security_bot integration)
# ------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Vyzn_security_bot
# Webhook secret token for validating incoming Telegram updates (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# Optional internal auth token for server-to-server alert ingress (/api/v1/alerts/ingress)
VYZN_INTERNAL_ALERT_TOKEN=

# ------------------------------------------------------------------------
# 5. PUBLIC URL & CLOUD DEPLOYMENT (Vercel / Production)
# ------------------------------------------------------------------------
# Public HTTPS URL of the deployed app (for Telegram inline buttons and clip links).
# On Vercel, VERCEL_URL is set automatically.
# VYZN_PUBLIC_URL=https://vyzn-security.vercel.app
# Secret key used for cryptographic HMAC-SHA256 session cookie verification in serverless lambdas:
# VYZN_SESSION_SECRET=

# ------------------------------------------------------------------------
# 6. CAMERA QUOTA & MANUAL UPI BILLING (Personal UPI QR Verification)
# ------------------------------------------------------------------------
# Personal UPI ID / VPA to receive payments directly to your bank account:
UPI_VPA=vyzn@upi

# Payee name displayed in customer's UPI application (GPay, PhonePe, Paytm):
UPI_PAYEE_NAME="VYZN Technologies"

# Price per camera quota slot in paise (e.g. 249900 paise = ₹2,499.00):
CAMERA_PRICE_PAISE=249900

# Maximum camera quota slots allowed in a single order:
MAX_CAMERAS_PER_ORDER=20

# Order expiry window in minutes (unpaid orders expire after this duration):
ORDER_EXPIRY_MINUTES=30

# Authorized admin user IDs or emails (comma-separated) for approving/rejecting payments:
ADMIN_USER_IDS="admin@vyzn.ai,usr_admin_001"

# Enable strict camera quota enforcement on camera creation (true | false):
# Default is false so existing local edge cameras and testing demos keep working uninterrupted.
BILLING_ENFORCEMENT=false

