# ========================================================================
# VYZN Netra — Environment Configuration
# ========================================================================

# ------------------------------------------------------------------------
# 1. OUTBOUND EMAIL (For Real Gmail / Email 6-Digit OTP Delivery)
# ------------------------------------------------------------------------
# To send real OTPs directly to your Gmail/Email, provide your Gmail address
# and a 16-character Google App Password (generate at https://myaccount.google.com/apppasswords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Alternative: Resend API (if using https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------
# 2. OUTBOUND MOBILE SMS (For Real Indian +91 SMS OTP Delivery)
# ------------------------------------------------------------------------
# Fast2SMS (Instant OTP gateway for Indian +91 numbers):
# Sign up at https://www.fast2sms.com and get your API Key from Dev API.
FAST2SMS_API_KEY=

# Alternative: Twilio SMS (International & India)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------
# 3. SUPABASE CLOUD DATABASE (User Storage & Login Audit Logs)
# ------------------------------------------------------------------------
# Create a free project at https://supabase.com
# Execute the SQL script in `supabase_setup.sql` in Supabase SQL Editor.
# Copy Project URL and Anon API Key from Project Settings -> API.
VYZN_SUPABASE_URL=
VYZN_SUPABASE_ANON_KEY=
VYZN_SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------
# 4. TELEGRAM ALERTS (Optional)
# ------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
